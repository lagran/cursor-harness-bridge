# Cursor Dashboard -> Integrations
CURSOR_API_KEY=

# "auto" works for every account. You may use any id returned by
# Cursor.models.list() for this API key.
CURSOR_MODEL=auto

# Project opened by the DeepSeek Harness Web UI.
CURSOR_WORKSPACE=/absolute/path/to/project

# Cursor SDK execution policy follows each session's Harness permission
# selector. Extra roots are readable in Read Only and available in Full Access;
# Workspace Write keeps writes inside the session's primary workspace.
CURSOR_ADDITIONAL_DIRS=
# Optional Cursor settings layers: project,user,team,mdm,plugins,all
CURSOR_SETTING_SOURCES=
# Reuse rules/skills/ignore workspace scans for five minutes.
CURSOR_WORKSPACE_SCAN_CACHE_MS=300000
# Cancel a Cursor run after this many milliseconds without any stream event.
CURSOR_RUN_STALL_MS=90000

# Used by scripts/install-systemd.sh.
HARNESS_DOMAIN=localhost
HARNESS_PORT=3080

# Optional overrides.
# DSH_HOME=~/.dsh
# CURSOR_BRIDGE_STATE_DIR=~/.dsh/cursor-agent-store
